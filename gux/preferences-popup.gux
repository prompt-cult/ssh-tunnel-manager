import 'gux:core';
import 'gux:tw';
import 'gux:controls';

/// SSH Tunnel Manager — settings window with the Preferences
/// popover open, anchored above the sidebar footer button.
Page('preferences-popup',
  viewport: Viewport(1280, 921),
  style: Style(bg: tw.white, text: '#1d1d1f', theme: 'light'),

  /// ── SIDEBAR ─────────────────────────────────────────────
  Zone('sidebar',
    bounds: Bounds(180, 50, 500, 840),
    style: Style(bg: '#f2f2f4', borderRight: '1px solid #e0e0e2'),
    children: [
      TunnelList(items: Dynamic('tunnels'),
        selected: 'New Tunnel',
        selectedStyle: Style(bg: '#2563eb', text: tw.white, rounded: 'lg'),
        child: TunnelListItem(name: Dynamic('name'),
          ports: Dynamic('ports'),
          dot: StatusDot(colour: '#3a3a3c', size: 8))),

      /// Footer: Preferences (popover anchor) + version.
      Zone('sidebar-footer',
        bounds: Bounds(180, 790, 500, 840),
        style: Style(bg: '#f2f2f4', px: 16, py: 8),
        children: [
          Row(justify: 'space-between', children: [
            LinkButton(label: 'Preferences', icon: 'gear',
              style: Style(text: '#1d1d1f', size: '12px')),
            Label('v1.10.0',
              style: Style(size: '12px', colour: '#8e8e93')),
          ]),
        ],
      ),
    ],
  ),

  /// ── PREFERENCES POPOVER ─────────────────────────────────
  /// Anchored above the Preferences footer button, tail pointing down.
  /// Light grey translucent macOS popover with port frontier controls.
  Zone('preferences-popover',
    bounds: Bounds(45, 490, 475, 840),
    style: Style(bg: '#ececed !important', rounded: '2xl',
      shadow: 'lg', border: '1px solid #d6d6d8', p: 16),
    children: [
      Label('Preferences',
        style: Style(font: 'bold', size: '15px', pb: 8)),

      /// Group 1: login item.
      CheckboxRow(label: 'Launch at Login', checked: true,
        checkbox: Checkbox(state: 'checked', onColour: '#2563eb',
          tick: tw.white, size: 18),
        style: Style(size: '14px', h: 36)),

      /// Divider between groups.
      Divider(style: Style(bg: '#c9c9cc', h: 1)),

      /// Group 2: connect/disconnect feedback.
      CheckboxRow(label: 'Play a sound on connect / disconnect',
        checked: true,
        checkbox: Checkbox(state: 'checked', onColour: '#2563eb',
          tick: tw.white, size: 18),
        style: Style(size: '14px', h: 36)),

      CheckboxRow(label: 'Show a notification on\nconnect / disconnect',
        checked: true,
        checkbox: Checkbox(state: 'checked', onColour: '#2563eb',
          tick: tw.white, size: 18),
        style: Style(size: '14px', h: 48)),

      /// Divider before port frontier.
      Divider(style: Style(bg: '#c9c9cc', h: 1)),

      /// Group 3: Port allocation frontier.
      CheckboxRow(label: 'Find next high port',
        checked: true,
        checkbox: Checkbox(state: 'checked', onColour: '#2563eb',
          tick: tw.white, size: 18),
        style: Style(size: '14px', h: 36)),

      FormRow(label: 'Default Service Port',
        child: Row(gap: 8, children: [
          TextInput(value: '4096', width: 75,
            style: Style(bg: tw.white, border: '1px solid #d1d5db', rounded: 'md', px: 8, py: 4)),
          IconButton('port-lock', icon: 'link',
            style: Style(colour: '#2563eb', size: 16)),
          TextInput(value: '4096', width: 75,
            style: Style(bg: tw.white, border: '1px solid #d1d5db', rounded: 'md', px: 8, py: 4)),
        ])),

      /// Footer buttons: Cancel and Save.
      Row(justify: 'space-between',
        style: Style(pt: 12),
        children: [
          Button(label: 'Cancel',
            style: Style(bg: '#e5e5ea', text: '#1d1d1f', rounded: 'md', px: 12, py: 6)),
          Button(label: 'Save',
            style: Style(bg: '#2563eb', text: tw.white, rounded: 'md', px: 14, py: 6)),
        ]),
    ],
  ),

  /// ── DETAIL PANE (structural presence only) ──────────────
  Zone('detail',
    bounds: Bounds(500, 50, 1205, 840),
    style: Style(bg: tw.white),
    assert: Assert(non_blank: true),
    children: [
      Zone('header', assert: Assert(non_blank: true), children: [
        Label('SSH Tunnel Manager'),
        Button(label: 'Save'),
      ]),
      Label('Tunnel'),
      FormRow(label: 'Name', child: TextInput(value: 'New Tunnel')),
      Label('SSH Connection'),
      FormRow(label: 'Mode', child: SegmentedControl(
        segments: ['Host', 'SSH Alias'], selected: 0)),
      FormRow(label: 'Host',
        child: TextInput(value: 'user@example.com')),
      FormRow(label: 'Identity File (optional)',
        child: TextInput(value: '')),
      Label('Port Forwarding'),
      Zone('status-card', assert: Assert(non_blank: true), children: [
        StatusLabel(text: 'Disconnected'),
        Button(label: 'Connect',
          style: Style(bg: '#33c558 !important', text: tw.white)),
      ]),
      Zone('ssh-command-card', assert: Assert(non_blank: true), children: [
        CodeBlock(text: Dynamic('ssh-command'), font: 'mono'),
      ]),
    ],
  ),
)
